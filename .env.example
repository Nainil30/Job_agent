# ---------------------------------------------------------------------------
# All settings are OPTIONAL. With nothing set, the agent still runs and ranks
# jobs with its free deterministic scorer. Add one LLM key for richer analysis.
# ---------------------------------------------------------------------------

# LLM provider: auto | gemini | groq | openrouter | ollama | none
# "auto" uses the first provider below that has a key configured.
LLM_PROVIDER=auto

# Google AI Studio free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (local, fully offline) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Free-tier guard rails
LLM_MAX_CALLS_PER_RUN=40
LLM_REQUESTS_PER_MINUTE=8

# ---------------------------------------------------------------------------
# Notifications (optional, all free) — sent only for NEW jobs >= NOTIFY_MIN_SCORE
# ---------------------------------------------------------------------------
NOTIFY_MIN_SCORE=80
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
